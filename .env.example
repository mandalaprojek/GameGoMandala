# ==============================================================================
# GAMEGOMANDALA - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env lalu isi dengan nilai yang sesuai.
# ==============================================================================

# 1. URL Web App Google Apps Script (GAS)
# Dapatkan URL ini setelah melakukan Deploy as Web App pada file backend/Code.gs
# Biarkan kosong jika ingin menggunakan Mock Data & LocalStorage offline demo.
VITE_GAS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbx_Contoh_Token_Deployment_GAS_Anda/exec

# 2. Google Spreadsheet ID
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# ID-nya adalah: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
VITE_SPREADSHEET_ID=

# 3. Pengaturan Toko & Ongkir
VITE_STORE_COORDS=-6.2088,106.8456
VITE_TARIF_ONGKIR_PER_KM=3000

# 4. WhatsApp Gateway (Opsional untuk integrasi Fonnte / Wablas / WAHA)
VITE_WA_GATEWAY_URL=
VITE_WA_API_TOKEN=
